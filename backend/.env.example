# Copy this file to .env and fill in your values before running locally.
# Generate a secret key with: python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=CHANGE_ME_use_a_long_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins (no wildcards)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Fernet key for at-rest data encryption
ENCRYPTION_KEY=

# Upload limits
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_REQUEST=10
